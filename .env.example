# Copier en .env (jamais commité). Bun charge .env automatiquement.

# Clé de l'API locale screenpipe : `screenpipe auth token` (ou appli : Réglages > Confidentialité)
SCREENPIPE_LOCAL_API_URL=http://localhost:3030
SCREENPIPE_LOCAL_API_KEY=

# Clé Claude (console Claude). Lue directement par le SDK.
ANTHROPIC_API_KEY=
CLAUDE_MODELE_RAPIDE=claude-haiku-5-5
CLAUDE_MODELE=claude-sonnet-5-5

# Variantes de la phrase d'appel, séparées par | (à ajuster après le test de la phase 0)
PHRASES_APPEL=ok claude|okay claude|ok clode|ok claud

PORT=4300
