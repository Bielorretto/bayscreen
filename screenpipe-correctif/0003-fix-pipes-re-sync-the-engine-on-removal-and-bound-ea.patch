-  const remove = (kind: "events" | "custom" | "sources", i: number) =>
-    persistTrigger({ ...trigger, [kind]: (trigger?.[kind] ?? []).filter((_, j) => j !== i) });
+  const remove = (kind: "events" | "custom" | "sources", i: number) => {
+    const enregistre = persistTrigger({ ...trigger, [kind]: (trigger?.[kind] ?? []).filter((_, j) => j !== i) });
+    // Condition retirée : le moteur arrête sa règle tout de suite.
