+  };
 
   const chip = "text-xs bg-muted/50 border rounded-sm px-3 py-1.5 flex-1 font-mono truncate";
   const xBtn = "text-muted-foreground/0 group-hover/item:text-muted-foreground hover:!text-foreground transition-all text-sm leading-none px-1";
@@ -251,8 +256,8 @@ export function PipeTriggerPicker(props: PickerProps) {
             onAddCustom={(texte) => {
               const enregistre = custom.includes(texte) ? null : persistTrigger({ ...trigger, custom: [...custom, texte] });
               setOpen(false);
-              // Pipe enregistrée : le moteur la relit tout de suite au lieu d'attendre sa prochaine minute.
-              enregistre?.then(() => fetch(`${DES_QUE}/api/pipes/synchroniser`, { method: "POST" })).catch(() => {});
+              // Pipe enregistrée d'abord : sinon le moteur relirait l'ancienne.
+              enregistre?.then(synchroniserDesQue, () => {});
             }}
           />
         </DialogContent>
@@ -317,7 +322,8 @@ function DesQueEtat({ pipeName, custom }: { pipeName: string; custom: string[] }
   useEffect(() => {
     let vivant = true;
     const lire = () =>
-      fetch(`${DES_QUE}/api/pipes/etat`)
+      // Délai sous l'intervalle : pas de requêtes empilées si le moteur ne répond plus.
+      fetch(`${DES_QUE}/api/pipes/etat`, { signal: AbortSignal.timeout(2500) })
         .then((r) => (r.ok ? r.json() : null))
         .catch(() => null)
         .then((j) => { if (vivant) setEtats(j ?? null); });
