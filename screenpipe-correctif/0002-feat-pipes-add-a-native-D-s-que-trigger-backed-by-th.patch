+// ── Dès que : état du moteur sous les pastilles custom ───────────────────────
+
+/** Le texte que le moteur traduit pour un pipe : ses entrées custom non vides, jointes par « ; ». */
+function texteDesQue(custom: string[]): string {
+  return custom.filter((c) => typeof c === "string" && c.trim()).join(" ; ").trim();
+}
+
+interface EtatDesQue {
+  declencheur: string;
+  statut: string;
+  regle: string;
+  motif: string;
+  actionId: string;
+  acces: { ok: boolean; texte: string }[];
+  essais: string[];
+}
+
+/** L'état de ce pipe dans la réponse du moteur, réduit à du texte : rien d'autre ne s'affiche. */
+function etatDesQue(data: unknown, pipe: string): EtatDesQue | null {
+  if (!data || typeof data !== "object" || !Object.prototype.hasOwnProperty.call(data, pipe)) return null;
+  const e = (data as Record<string, unknown>)[pipe];
+  if (!e || typeof e !== "object") return null;
+  const o = e as Record<string, unknown>;
+  const texte = (v: unknown) => (typeof v === "string" ? v : "");
+  return {
+    declencheur: texte(o.declencheur),
+    statut: texte(o.statut),
+    regle: texte(o.regle),
+    motif: texte(o.motif),
+    actionId: texte(o.actionId),
+    acces: (Array.isArray(o.acces) ? o.acces : []).map((a) => {
+      const x = (a && typeof a === "object" ? a : {}) as Record<string, unknown>;
+      return { ok: x.ok === true, texte: `${texte(x.acces)} : ${texte(x.detail)}` };
+    }),
+    essais: (Array.isArray(o.essais) ? o.essais : []).filter((l): l is string => typeof l === "string"),
+  };
+}
+
+const STATUT_DES_QUE = new Map([
+  ["branchee", "branchée"],
+  ["a_valider", "à valider"],
+  ["refusee", "non branchée"],
+  ["erreur", "erreur"],
+  ["retiree", "retirée"],
+]);
+
+function DesQueEtat({ pipeName, custom }: { pipeName: string; custom: string[] }) {
+  // undefined : pas encore de réponse ; null : moteur injoignable ; sinon l'état de tous les pipes.
+  const [etats, setEtats] = useState<unknown>(undefined);
+  const [relire, setRelire] = useState(0);
+  const [occupe, setOccupe] = useState(false);
+  const [echec, setEchec] = useState("");
+
+  useEffect(() => {
+    let vivant = true;
+    const lire = () =>
+      fetch(`${DES_QUE}/api/pipes/etat`)
+        .then((r) => (r.ok ? r.json() : null))
+        .catch(() => null)
+        .then((j) => { if (vivant) setEtats(j ?? null); });
+    lire();
+    const minuteur = setInterval(lire, 3000);
+    return () => { vivant = false; clearInterval(minuteur); };
+  }, [pipeName, relire]);
+
+  async function decider(verbe: "valider" | "refuser", actionId: string) {
+    setOccupe(true);
+    setEchec("");
+    try {
+      const r = await fetch(`${DES_QUE}/api/actions/${encodeURIComponent(actionId)}/${verbe}`, { method: "POST" });
+      if (!r.ok) {
+        const j = await r.json().catch(() => null);
+        setEchec(typeof j?.erreur === "string" ? j.erreur : `HTTP ${r.status}`);
+      }
+    } catch {
+      setEchec("moteur injoignable");
+    }
+    setOccupe(false);
+    setRelire((n) => n + 1);
+  }
+
+  if (etats === undefined) return null;
+  const ligne = "pl-3 text-[11px] text-muted-foreground break-words";
+  if (etats === null) return <div className={ligne}>Dès que : moteur injoignable (127.0.0.1:4300)</div>;
+  const etat = etatDesQue(etats, pipeName);
+  if (!etat || !etat.statut || etat.declencheur.trim() !== texteDesQue(custom)) {
+    return <div className={ligne}>Dès que : en attente de traduction</div>;
+  }
+  const active = etat.statut === "branchee" || etat.statut === "a_valider";
+  const accesOk = etat.acces.filter((a) => a.ok).length;
+  const essaisOk = etat.essais.filter((l) => l.startsWith("OK")).length;
+  return (
+    <div className={`${ligne} space-y-1`}>
+      <div className="font-medium">Dès que : {STATUT_DES_QUE.get(etat.statut) ?? etat.statut}</div>
+      {active && etat.regle && <div className="font-mono">{etat.regle}</div>}
+      {!active && etat.motif && <div>{etat.motif}</div>}
+      {etat.statut === "a_valider" && (
+        <>
+          <div title={[...etat.acces.map((a) => a.texte), ...etat.essais].join("\n")}>
+            accès {accesOk}/{etat.acces.length} · essais {essaisOk}/{etat.essais.length}
+          </div>
+          {etat.actionId && (
+            <div className="flex items-center gap-1.5 pt-0.5">
+              <button disabled={occupe} onClick={() => decider("valider", etat.actionId)} className={BTN_PRIMARY.replace("h-9", "h-7")}>Valider</button>
+              <button disabled={occupe} onClick={() => decider("refuser", etat.actionId)} className={`${BTN_SECONDARY.replace("h-9", "h-7")} disabled:opacity-40`}>Refuser</button>
+            </div>
+          )}
+          {echec && <div>Dès que : {echec}</div>}
+        </>
+      )}
+    </div>
+  );
+}
