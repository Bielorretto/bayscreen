+#!/usr/bin/env bash
+# screenpipe — AI that knows everything you've seen, said, or heard
+# https://screenpipe.com
+
+# Native notification panel: clicked actions keep every documented field.
+# PANEL_SWIFT overrides the panel source, e.g. to show the test failing on an older version.
+
+set -euo pipefail
+
+if [[ "$(uname -s)" != "Darwin" ]]; then
+    echo "skipping notification panel action tests: macOS only"
+    exit 0
+fi
+
+script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+app_dir="$(cd "$script_dir/.." && pwd)"
+swift_dir="$app_dir/src-tauri/swift"
+panel_swift="${PANEL_SWIFT:-$swift_dir/notification_panel.swift}"
+out_dir="$(mktemp -d "${TMPDIR:-/tmp}/screenpipe-notification-panel-tests.XXXXXX")"
+trap 'rm -rf "$out_dir"' EXIT
+binary="$out_dir/notification-panel-action-tests"
+
+sdk_path="$(xcrun --sdk macosx --show-sdk-path)"
+if [[ "$(uname -m)" == "x86_64" ]]; then
+    swift_target="x86_64-apple-macos13.0"
+else
+    swift_target="arm64-apple-macos13.0"
+fi
+
+xcrun swiftc \
+    -swift-version 5 \
+    -sdk "$sdk_path" \
+    -target "$swift_target" \
+    "$swift_dir/UILocalization.swift" \
+    "$panel_swift" \
+    "$swift_dir/notification_panel_action_tests.swift" \
+    -o "$binary"
+
+"$binary"
