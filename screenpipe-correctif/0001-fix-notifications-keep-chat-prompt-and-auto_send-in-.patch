+++ b/apps/screenpipe-app-tauri/src-tauri/swift/notification_panel_action_tests.swift
@@ -0,0 +1,37 @@
+// screenpipe — AI that knows everything you've seen, said, or heard
+// https://screenpipe.com
+
+// The native panel re-encodes the clicked action with JSONEncoder before handing it
+// to Rust (notification_panel.swift, onAction). Any field missing from
+// NotificationAction is dropped on the way, so a documented `chat` button
+// (SKILL.md: optional `prompt` and `auto_send`) must survive that round trip.
+import Foundation
+
+@main
+struct NotificationPanelActionTests {
+    static var checks = 0
+    static func expect(_ condition: Bool, _ message: String) {
+        checks += 1
+        guard condition else {
+            FileHandle.standardError.write(Data("FAIL: \(message)\n".utf8))
+            exit(1)
+        }
+    }
+
+    static func main() {
+        // The `chat` example from the screenpipe-api SKILL.md, plus its optional auto_send.
+        let sent = #"{"id":"go","label":"draft it","type":"chat","primary":true,"prompt":"summarize meeting 274 into a short CRM follow-up note and save it to output/","context":{"meeting_id":274},"auto_send":false}"#
+        guard let action = try? JSONDecoder().decode(NotificationAction.self, from: Data(sent.utf8)),
+              let data = try? JSONEncoder().encode(action),
+              let clicked = try? JSONSerialization.jsonObject(with: data) as? [String: Any]
+        else {
+            expect(false, "chat action must round-trip through NotificationAction")
+            return
+        }
+        expect(clicked["type"] as? String == "chat", "type survives the click")
+        expect(clicked["prompt"] as? String == "summarize meeting 274 into a short CRM follow-up note and save it to output/",
+               "prompt survives the click")
+        expect(clicked["auto_send"] as? Bool == false, "auto_send: false survives the click")
+        print("notification panel actions: \(checks) checks passed")
+    }
+}
