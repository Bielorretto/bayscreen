[
  {
    "id": "exemple-seuil",
    "nom": "Casque audio sous 100 € → notification",
    "active": true,
    "desQue": {
      "source": "web",
      "type": "valeur_changee",
      "si": [
        {
          "champ": "nom",
          "op": "egal",
          "valeur": "Casque audio"
        },
        {
          "champ": "valeur",
          "op": "inferieur",
          "valeur": 100
        },
        {
          "champ": "ancienne",
          "op": "superieur",
          "valeur": 100
        }
      ]
    },
    "alors": {
      "mode": "fixe",
      "action": "notifier",
      "params": {
        "text": "{{nom}} : {{valeurTexte}} € (avant : {{ancienne}} €)"
      }
    },
    "validation": "auto"
  },
  {
