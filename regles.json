  {
    "id": "exemple-mail",
    "nom": "Mail reçu → Claude propose un message Discord",
    "active": true,
    "desQue": {
      "source": "mail",
      "type": "mail_recu"
    },
    "alors": {
      "mode": "ia",
      "consigne": "Si le mail demande une réponse ou une action rapide, propose un message Discord court pour l’équipe : qui demande quoi, et pour quand. Si « memoire » montre un élément utile vu à l’écran (document, prix, date), cite-le avec l’heure où il a été vu. Paramètres : {\"content\": \"le message\"}. Ne recopie jamais d’adresse mail : le prénom suffit. Sinon, ne propose rien.",
      "actionsPermises": [
        "discord.envoyer",
        "notifier"
      ]
    },
    "validation": "demander"
  },
